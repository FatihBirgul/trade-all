# /etc/tradebot/tradebot.env dosyasina kopyalanir (izin 600). Gercek degerler ASLA repoya girmez.
EXNESS_API_KEY=
# 128 hex karakter (Exness'in urettigi anahtar) ya da sifresiz PKCS#8 PEM (tek satirda \n ile)
EXNESS_PRIVATE_KEY=
EXNESS_ACCOUNT_ID=
# Key Management'taki DNS widget'inda gorunen Gateway host (https:// olmadan da olur)
EXNESS_GATEWAY_HOST=
# Istege bagli: hesabin Access Point host'u. Bos birakilirsa Gateway'den kesfedilir.
EXNESS_AP_HOST=
# Istege bagli
# TRADEBOT_DB_PATH=/var/lib/tradebot/tradebot.db
# TRADEBOT_API_BIND=127.0.0.1:8090
